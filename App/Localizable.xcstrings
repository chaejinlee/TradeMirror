    "%lld 笔开仓时间正好 11:00,是旧版本没认出时间时填的(在复盘页改成真实时间就会算进来)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld entered at exactly 11:00 — the old version's placeholder when no time was read (fix the time on the review page and they'll count)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 笔开仓时间正好 11:00,是旧版本没认出时间时填的(在复盘页改成真实时间就会算进来)"
          }
        }
      }
    },
    "%lld 笔未平": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld still open"
          }
        }
      }
    },
    "%lld 笔答过": {
      "extractionState": "manual",
      "localizations": {
